<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Unbar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">#1A5BAA</item>
        <item name="android:navigationBarColor">#F6F9FD</item>
        <!-- Launch window background: branded drawable (see
             res/drawable/launch_background.xml), so the window is
             never a blank color before Compose draws its first
             frame. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
