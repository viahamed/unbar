"tutorial.title" = "Tutorial";
"guide.title" = "Guide";
"tutorial.settings.group_connection" = "Connection";
"tutorial.settings.group_resolvers" = "Resolvers";
"tutorial.settings.group_proxy_bandwidth" = "Local SOCKS proxy and bandwidth limit";
"tutorial.settings.group_routing" = "Routing";
"tutorial.settings.group_system" = "System & diagnostics";
"tutorial.servers.add.title" = "Add server";
"tutorial.servers.add.body" = "Tap + to add a new server: enter the server name, zone, and the server's public key. Without a server, you cannot connect.";
"tutorial.servers.import.title" = "Import config and QR";
"tutorial.servers.import.body" = "Instead of entering the details by hand, import an unbar:// link or scan a QR code of the config; the server is added automatically.";
"tutorial.servers.subscription.title" = "Subscription";
"tutorial.servers.subscription.body" = "Enter a subscription link and the server list will update automatically from that link. Servers you added by hand are left untouched.";
"tutorial.servers.latency.title" = "Latency test and server selection";
"tutorial.servers.latency.body" = "The latency test measures how fast each server responds. Auto-select picks the fastest server for the connection.";
"tutorial.servers.edit.title" = "Edit, delete, and export";
"tutorial.servers.edit.body" = "Tap a server to edit or delete it. Export config shares a server's config as a link or a QR code.";
"tutorial.settings.vpn.title" = "VPN mode / SOCKS mode";
"tutorial.settings.vpn.body" = "VPN mode routes all of the phone's traffic through the tunnel; SOCKS mode only serves apps that have the proxy configured. You change it here in Settings — the Home card has no mode switch — and a change applies on the next connection. For everyday use, choose VPN mode.";
"tutorial.settings.tcp.title" = "TCP mode";
"tutorial.settings.tcp.body" = "Forces DNS queries over TCP/53 instead of UDP/53. Use it only when UDP is blocked, as it is slower. When off, TCP is still used where UDP fails.";
"tutorial.settings.mtu.title" = "MTU";
"tutorial.settings.mtu.body" = "MTU is the size of network packets on the tunnel (default Auto). In Auto, the active interface MTU is measured and 200 bytes are subtracted (clamped to 1280–1500); the new value applies on the next connection. Usually there is no need to change it.";
"tutorial.settings.answer_size.title" = "DNS answer size";
"tutorial.settings.answer_size.body" = "The maximum size of each DNS answer (default Auto). Auto picks the best value; change it only if you have a problem.";
"tutorial.settings.resolvers.title" = "Resolvers";
"tutorial.settings.resolvers.body" = "Resolvers are the DNS servers the tunnel uses. Built-in uses the built-in list of Iranian resolvers; in Custom mode only the resolvers you entered yourself are used.";
"tutorial.settings.test_resolvers.title" = "Scan resolvers and health";
"tutorial.settings.test_resolvers.body" = "The Scan resolvers button checks the resolvers in three stages: first DNS and RTT screening, then a Soar handshake on all stage-1 responders (the verified count rises live and it works even before connecting), and finally ranking and saving every verified resolver into one pool. The Active resolvers card shows how many resolvers are currently carrying traffic — dead ones are replaced automatically, so there is no need to scan again.";
"tutorial.settings.proxy.title" = "Local SOCKS proxy";
"tutorial.settings.proxy.body" = "While the VPN is connected, a SOCKS proxy also runs on the phone (default port 1080). Set it in your browser or other apps so that only that app uses the tunnel.";
"tutorial.settings.bandwidth.title" = "Bandwidth limit";
"tutorial.settings.bandwidth.body" = "Limits the maximum upload and download speed of the tunnel, in KB/s. 0 means no limit.";
"tutorial.settings.geo_bypass.title" = "Iran geo bypass (.ir & IR IPs)";
"tutorial.settings.geo_bypass.body" = "Connects Iranian domains and IPs directly, without sending them through the tunnel, so domestic sites open faster. If the direct connection fails within 5 seconds, it falls back to the tunnel.";
"tutorial.settings.bypass_list.title" = "Custom bypass list";
"tutorial.settings.bypass_list.body" = "Write the domains or IPs you want to keep out of the tunnel here, one per line.";
"tutorial.settings.update.title" = "Check for update";
"tutorial.settings.update.body" = "Checks whether a newer release is available. If you are on the latest version, you will see a confirmation; if a newer version is available, a dialog shows the version and what's new. Tap Open release page to see the release in Safari and get the update from there.";
"tutorial.settings.logs.title" = "Logs";
"tutorial.settings.logs.body" = "The Logs page in Settings shows only the entries you need by default — connection events, errors, warnings, your own actions, and scan results. The repeating technical lines that arrive every 20 seconds are hidden; turn on \"Show details\" to see them.";
"tutorial.home.status.title" = "Status card and connection";
"tutorial.home.status.body" = "The status card shows whether the tunnel is up and which server you are on. Tap the footer to connect or disconnect. If no server is configured, add your own server first — the app ships with none.";
"tutorial.home.server.title" = "Server and IP";
"tutorial.home.server.body" = "While connected, the card shows the server's IP address and country. The country is looked up from the server's IP, so it tells you where your traffic exits.";
"tutorial.home.mode.title" = "VPN mode / Proxy mode";
"tutorial.home.mode.body" = "VPN mode routes all of the phone's traffic through the tunnel; Proxy mode only serves apps that have the proxy configured. You choose the mode in Settings — there is no mode switch on the Home card. A change applies the next time you connect. For everyday use, choose VPN mode.";
"tutorial.home.download.title" = "Download and upload";
"tutorial.home.download.body" = "Live speeds on the wire, as actually sent through the tunnel.";
"tutorial.home.latency.title" = "Latency";
"tutorial.home.latency.body" = "Latency is the round-trip time to your server, measured through the tunnel. Lower is better; under 200 ms feels fast.";
"tutorial.home.quality.title" = "Connection quality";
"tutorial.home.quality.body" = "A score from 0 to 100 built from path health, latency and loss. The shield shows the same score in five bars: more lit bars, a better connection.";
"tutorial.home.active.title" = "Active resolvers";
"tutorial.home.active.body" = "How many resolvers are currently carrying traffic. Dead ones are replaced automatically, so there is no need to scan again.";
"tutorial.home.scan.title" = "Scan resolvers";
"tutorial.home.scan.body" = "Checks the resolvers in three stages: DNS and RTT screening, a Soar handshake on all responders, and saving every verified resolver into one pool.";
"tutorial.home.today.title" = "Today";
"tutorial.home.today.body" = "How much data the tunnel has carried today. The counter resets at midnight.";
"tutorial.home.session.title" = "Session total";
"tutorial.home.session.body" = "How much data this session has carried, up and down combined. It keeps counting across reconnects.";
"tutorial.home.time.title" = "Connection time";
"tutorial.home.time.body" = "How long the current session has been up. It restarts on every reconnect.";
"tutorial.home.streams.title" = "Streams";
"tutorial.home.streams.body" = "How many streams the tunnel is currently carrying. More streams usually means more apps or downloads active.";

