"tutorial.servers.edit.body" = "روی هر سرور بزنید تا ویرایش یا حذفش کنید. خروجی تنظیمات کانفیگ سرور را به‌صورت لینک یا QR برای اشتراک‌گذاری صادر می‌کند.";
"tutorial.settings.vpn.title" = "حالت VPN / SOCKS";
"tutorial.settings.vpn.body" = "حالت VPN همه ترافیک گوشی را از تونل می‌گذراند؛ حالت SOCKS فقط برنامه‌هایی که پروکسی را تنظیم کرده‌اند. آن را همین‌جا در تنظیمات عوض می‌کنید — کارت صفحهٔ اصلی دکمهٔ تغییر حالت ندارد — و تغییر از اتصال بعدی اعمال می‌شود. برای استفاده روزمره VPN را انتخاب کنید. پاسخ‌های DNS در هر دو حالت در حافظه نگه داشته می‌شوند؛ اگر تونل لحظه‌ای قطع شود، نام‌هایی که در یک روز گذشته پیدا شده‌اند همچنان جواب می‌گیرند تا برنامه‌ها از کار نیفتند.";
"tutorial.settings.tcp.title" = "حالت TCP";
"tutorial.settings.tcp.body" = "برای هر ریزالور، کنار UDP یک مسیر TCP/53 هم اضافه می‌کند. وقتی UDP مسدود است کمک می‌کند، ولی باتری بیشتری مصرف می‌کند. در حالت خاموش، TCP فقط جایی به کار می‌رود که UDP جواب ندهد. از اتصال بعدی اعمال می‌شود.";
"tutorial.settings.mtu.title" = "MTU";
"tutorial.settings.mtu.body" = "MTU اندازه بسته‌های شبکه روی تونل است (پیش‌فرض خودکار). در حالت خودکار، MTU اینترفیس فعال اندازه‌گیری و ۲۰۰ بایت کم می‌شود (بین ۱۲۸۰ تا ۱۵۰۰)؛ مقدار جدید روی اتصال بعدی اعمال می‌شود. معمولاً نیازی به تغییر نیست.";
"tutorial.settings.answer_size.title" = "اندازه پاسخ DNS";
"tutorial.settings.answer_size.body" = "حداکثر حجم هر پاسخ DNS است (پیش‌فرض خودکار). خودکار تا ۱۲۳۲ بایت را امتحان می‌کند و بهترین مقدار را انتخاب می‌کند؛ گزینه‌های دستی ۵۱۲، ۷۵۲ و ۹۹۲ سقف را پایین‌تر می‌گذارند (تونل با پله‌های ۴۸ بایتی کار می‌کند). فقط در صورت مشکل آن را تغییر دهید؛ تغییر با اتصال بعدی اعمال می‌شود.";
"tutorial.settings.resolvers.title" = "ریزالورها";
"tutorial.settings.resolvers.body" = "ریزالورها سرورهای DNS هستند که تونل از آن‌ها استفاده می‌کند. حالت داخلی از لیست داخلی ریزالورهای ایرانی استفاده می‌کند؛ در حالت سفارشی فقط ریزالورهایی که خودتان وارد کرده‌اید به کار می‌روند؛ حالت «وارد کردن» فقط از لیستی استفاده می‌کند که از یک فایل ‎.txt‎ بارگذاری شده (آی‌پی تکی و رنج، خودکار تمیز و مرتب می‌شود). حالت داخلی ریزالورهای سالم را برای هر شبکه — اپراتور موبایل یا وای‌فای — جداگانه به خاطر می‌سپارد، پس اتصال دوباره روی شبکهٔ آشنا از ریزالورهایی شروع می‌شود که همان‌جا کار کرده‌اند.";
"tutorial.settings.test_resolvers.title" = "اسکن ریزالورها و سلامت";
"tutorial.settings.test_resolvers.body" = "دکمه اسکن ریزالورها در سه مرحله ریزالورها را بررسی می‌کند: اول غربال DNS و RTT، بعد هندشیک Soar روی همه جواب‌دهنده‌های مرحله اول (شمارنده تأییدشده‌ها زنده بالا می‌رود و حتی قبل از وصل شدن کار می‌کند)، و در آخر رتبه‌بندی و ذخیره همه ریزالورهای تأییدشده در یک استخر. «اسکن روی» نوع انتقال را تعیین می‌کند: UDP (پیش‌فرض) یا UDP + TCP که ریزالورهایی را هم نگه می‌دارد که فقط از راه TCP/53 جواب می‌دهند — اسکن طولانی‌تر می‌شود. کنار هر ریزالور ذخیره‌شده برچسب انتقالی که با آن تأیید شده دیده می‌شود: UDP، TCP یا UDP·TCP؛ هر ریزالور فقط یک بار فهرست می‌شود، حتی اگر هر دو مسیر را داشته باشد. «مکث» اسکن را نگه می‌دارد و «ادامه» آن را ادامه می‌دهد؛ «توقف» نتیجه‌های تا آن لحظه را نگه می‌دارد. در حالت سفارشی و «وارد کردن»، کارت نشان می‌دهد لیست شما چند ریزالور می‌دهد و اگر رنجی بزرگ‌تر از ‎/20‎ کنار گذاشته شود یا لیست به ۵۰۰۰ محدود شود، هشدار می‌دهد. کارت ریزالورهای فعال نشان می‌دهد چند ریزالور در حال حاضر ترافیک را حمل می‌کنند؛ ریزالورهای ازکارافتاده خودکار جایگزین می‌شوند و نیازی به اسکن دوباره نیست.";
"tutorial.settings.proxy.title" = "پروکسی SOCKS محلی";
"tutorial.settings.proxy.body" = "وقتی VPN وصل است، یک پروکسی SOCKS هم روی گوشی اجرا می‌شود (پیش‌فرض پورت 1080). آن را در مرورگر یا برنامه‌های دیگر تنظیم کنید تا فقط آن برنامه از تونل استفاده کند.";
"tutorial.settings.bandwidth.title" = "محدودیت پهنای باند";
"tutorial.settings.bandwidth.body" = "حداکثر سرعت آپلود و دانلود تونل را بر حسب KB/s محدود می‌کند. صفر یعنی بدون محدودیت.";
"tutorial.settings.geo_bypass.title" = "عبور مستقیم ایران";
"tutorial.settings.geo_bypass.body" = "دامنه‌ها و IPهای ایرانی را مستقیم وصل می‌کند و از تونل رد نمی‌کند، تا سایت‌های داخلی سریع‌تر باز شوند. اگر اتصال مستقیم در ۵ ثانیه جواب ندهد، به تونل برمی‌گردد.";
"tutorial.settings.bypass_list.title" = "لیست عبور سفارشی";
"tutorial.settings.bypass_list.body" = "دامنه یا IPهایی که می‌خواهید از تونل رد نشوند را اینجا بنویسید؛ هر کدام در یک خط.";
"tutorial.settings.update.title" = "بررسی به‌روزرسانی";
"tutorial.settings.update.body" = "بررسی می‌کند نسخهٔ جدیدی منتشر شده یا نه. اگر از آخرین نسخه استفاده می‌کنید، یک پیام تأیید می‌بینید؛ اگر نسخهٔ جدیدی باشد، یک پنجره شمارهٔ نسخه و تغییرات را نشان می‌دهد. «باز کردن صفحهٔ انتشار» را بزنید تا نسخه در Safari باز شود و به‌روزرسانی را از آنجا دریافت کنید.";
"tutorial.settings.logs.title" = "گزارش‌ها";
"tutorial.settings.logs.body" = "صفحهٔ گزارش‌ها در تنظیمات به‌طور پیش‌فرض فقط مواردی را نشان می‌دهد که به آن‌ها نیاز دارید — رویدادهای اتصال، خطاها، هشدارها، کارهای خودتان و نتیجهٔ اسکن. خط‌های فنی تکراری که هر ۲۰ ثانیه می‌آیند پنهان‌اند؛ «نمایش جزئیات» را روشن کنید تا آن‌ها را هم ببینید.";
"tutorial.home.status.title" = "کارت وضعیت و اتصال";
"tutorial.home.status.body" = "کارت وضعیت نشان می‌دهد تونل وصل است یا نه و روی کدام سرور هستید. با زدن فوتر وصل یا قطع می‌شوید. اگر سروری پیکربندی نشده، اول سرور خودتان را اضافه کنید — اپ بدون سرور پیش‌فرض عرضه می‌شود.";
"tutorial.home.server.title" = "سرور و IP";
"tutorial.home.server.body" = "موقع وصل بودن، کارت IP و کشور سرور را نشان می‌دهد. کشور از روی IP سرور پیدا می‌شود، پس می‌گوید ترافیک شما از کجا خارج می‌شود.";
"tutorial.home.mode.title" = "حالت VPN / پروکسی";
"tutorial.home.mode.body" = "حالت VPN همه ترافیک گوشی را از تونل می‌گذراند؛ حالت پروکسی فقط برنامه‌هایی که پروکسی را تنظیم کرده‌اند. حالت را در تنظیمات انتخاب می‌کنید — روی کارت صفحهٔ اصلی دکمهٔ تغییر حالت نیست. تغییر، از اتصال بعدی اعمال می‌شود. برای استفاده روزمره VPN را انتخاب کنید.";
"tutorial.home.download.title" = "دانلود و آپلود";
"tutorial.home.download.body" = "سرعت زنده روی سیم، همان‌طور که واقعاً از تونل رد می‌شود.";
"tutorial.home.latency.title" = "تأخیر";
"tutorial.home.latency.body" = "تأخیر زمان رفت‌وبرگشت تا سرور از داخل تونل است. کمتر بهتر است؛ زیر ۲۰۰ میلی‌ثانیه سریع حس می‌شود.";
"tutorial.home.quality.title" = "کیفیت اتصال";
"tutorial.home.quality.body" = "امتیازی از ۰ تا ۱۰۰ بر اساس سلامت مسیرها، تأخیر و لاس. شیلد همان امتیاز را با پنج نوار نشان می‌دهد: هرچه نوار روشن بیشتر، اتصال بهتر.";
"tutorial.home.active.title" = "ریزالورهای فعال";
"tutorial.home.active.body" = "چند ریزالور در حال حاضر ترافیک را حمل می‌کنند. خراب‌ها خودکار جایگزین می‌شوند و نیازی به اسکن دوباره نیست.";
"tutorial.home.scan.title" = "اسکن ریزالورها";
"tutorial.home.scan.body" = "ریزالورها را در سه مرحله بررسی می‌کند: غربال DNS و RTT، هندشیک Soar روی همه جواب‌دهنده‌ها، و ذخیره همه تأییدشده‌ها در یک استخر.";
"tutorial.home.today.title" = "امروز";
